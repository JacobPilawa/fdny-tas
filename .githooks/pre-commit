#!/bin/sh
# On every commit that touches core/ (enable once per clone: git config core.hooksPath .githooks):
#   - architecture rules (core/CLAUDE.md, core/tools/arch_check.py);
#   - the key sheet (D41): core/tools/docgen.py reads the source (a registration it can't
#     read stops the commit) and rewrites the repository's README.md (the key sheet for the
#     current source), which is added to the commit.
#     It reads the working tree, like arch_check.
PY="environment/local/tools/python/python.exe"
[ -x "$PY" ] || PY=python
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -q '^core/'; then
    if ! "$PY" -I core/tools/arch_check.py; then
        echo "pre-commit: arch_check failed -- fix the code (rules + reasons: core/CLAUDE.md, core/DECISIONS.md)"
        exit 1
    fi
    if ! "$PY" -I core/tools/docgen.py sheet README.md; then
        echo "pre-commit: docgen failed -- see above (what it reads: core/tools/docgen.py)"
        exit 1
    fi
    git add README.md
fi
exit 0
